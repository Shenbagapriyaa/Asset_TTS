{
  "name": "intern/ci4-asset-multitenant",
  "description": "CodeIgniter 4 Asset Management with Shield, TOTP and separate database per tenant",
  "type": "project",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.6",
    "codeigniter4/shield": "^1.2",
    "robthree/twofactorauth": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@php spark shield:setup"
    ]
  }
}
