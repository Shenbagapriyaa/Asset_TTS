CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.defaultLocale = en
app.negotiateLocale = false
encryption.key =

database.default.hostname = 127.0.0.1
database.default.database = asset_central
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Central database is used only for tenant registry / super-admin registry.
CENTRAL_DB_HOST = 127.0.0.1
CENTRAL_DB_NAME = asset_central
CENTRAL_DB_USER = root
CENTRAL_DB_PASS =
CENTRAL_DB_PORT = 3306

# All tenant databases are created with this DB user. In production use a
# restricted database account and do not expose these values to users.
TENANT_DB_HOST = 127.0.0.1
TENANT_DB_USER = root
TENANT_DB_PASS =
TENANT_DB_PORT = 3306

# Password-reset email. Keep SMTP credentials in the local .env file only.
email.protocol = smtp
email.fromEmail = 'noreply@example.com'
email.fromName = 'Asset Management'
email.SMTPHost =
email.SMTPAuthMethod = login
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.SMTPTimeout = 10
